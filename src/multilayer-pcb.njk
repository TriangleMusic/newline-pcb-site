         data-pswp-width="1920" data-pswp-height="1280"
         target="_blank" rel="noopener">
        <img src="/assets/img/gallery/multilayer/{{ num }}-thumb.jpg"
             alt="Multi-layer PCB sample {{ n }}" loading="lazy">
      </a>
      {% endfor %}
    </div>
  </div>
</section>
