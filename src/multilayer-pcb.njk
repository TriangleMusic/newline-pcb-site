<section class="page-hero" style="background-image: linear-gradient(135deg, var(--brand-blue), var(--brand-blue-dark));">
  <div class="container">
    <h1 class="page-hero__title">Multi-Layer PCB</h1>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="gallery" id="gallery-multilayer">
      {% for n in range(1, 13) %}
